rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email_verified == true;
    }

    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Comments: đọc công khai, tạo cần đăng nhập (anonymous), sửa/xóa cho chủ hoặc admin
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name', 'comment', 'presence', 'parentId', 'likes', 'isAdmin', 'createdAt', 'updatedAt', 'ownerId'
        ])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.isAdmin == false
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if (
        // Ai cũng có thể thay đổi likes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        request.resource.data.likes is int &&
        request.resource.data.likes >= 0
      ) || (
        // Chủ comment có thể sửa nội dung
        isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'presence', 'updatedAt'])
      ) || isAdmin();
      allow delete: if isOwner() || isAdmin();
    }

    // Config: đọc công khai, chỉ admin ghi
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
