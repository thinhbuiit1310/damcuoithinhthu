rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Comments: ai c\u0169ng \u0111\u1ecdc, t\u1ea1o \u0111\u01b0\u1ee3c; update ch\u1ec9 cho ph\u00e9p thay \u0111\u1ed5i likes ho\u1eb7c admin; x\u00f3a ch\u1ec9 admin
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'comment', 'presence', 'parentId', 'likes', 'isAdmin', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.likes is int
      && request.resource.data.likes >= 0
      && request.resource.data.isAdmin == false;
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        request.resource.data.likes is int &&
        request.resource.data.likes >= 0
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Config: ai c\u0169ng \u0111\u1ecdc, ch\u1ec9 admin ghi
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
