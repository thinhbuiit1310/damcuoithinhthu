rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Comments: ai c\u0169ng \u0111\u1ecdc \u0111\u01b0\u1ee3c, ai c\u0169ng t\u1ea1o \u0111\u01b0\u1ee3c, ai c\u0169ng update \u0111\u01b0\u1ee3c (cho like), ch\u1ec9 admin x\u00f3a
    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null;
    }

    // Config: ai c\u0169ng \u0111\u1ecdc \u0111\u01b0\u1ee3c, ch\u1ec9 admin ghi
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
