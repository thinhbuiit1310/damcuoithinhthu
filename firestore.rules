rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    // Comments: ai cũng đọc, tạo được; update chỉ cho phép thay đổi likes hoặc admin; xóa chỉ admin
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'comment', 'presence', 'parentId', 'likes', 'isAdmin', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.likes is int
      && request.resource.data.likes >= 0
      && request.resource.data.isAdmin == false;
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        request.resource.data.likes is int &&
        request.resource.data.likes >= 0
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Config: ai cũng đọc, chỉ admin ghi
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
